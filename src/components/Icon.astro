---
// Symbole aus lucide-static (ISC-Lizenz), direkt als SVG eingebettet.
import house from 'lucide-static/icons/house.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import search from 'lucide-static/icons/search.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import messageCircle from 'lucide-static/icons/message-circle.svg?raw';
import monitor from 'lucide-static/icons/monitor.svg?raw';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import bookOpen from 'lucide-static/icons/book-open.svg?raw';
import list from 'lucide-static/icons/list.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import circleCheck from 'lucide-static/icons/circle-check.svg?raw';
import printer from 'lucide-static/icons/printer.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import lifeBuoy from 'lucide-static/icons/life-buoy.svg?raw';
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import triangleAlert from 'lucide-static/icons/triangle-alert.svg?raw';
import sheet from 'lucide-static/icons/sheet.svg?raw';
import music from 'lucide-static/icons/music.svg?raw';
import aLargeSmall from 'lucide-static/icons/a-large-small.svg?raw';

const ICONS: Record<string, string> = {
  house,
  'arrow-left': arrowLeft,
  search,
  phone,
  'message-circle': messageCircle,
  monitor,
  'file-text': fileText,
  'shield-check': shieldCheck,
  sparkles,
  'book-open': bookOpen,
  list,
  check,
  'circle-check': circleCheck,
  printer,
  clock,
  'chevron-right': chevronRight,
  'life-buoy': lifeBuoy,
  lightbulb,
  'triangle-alert': triangleAlert,
  'a-large-small': aLargeSmall,
  sheet,
  music,
};

interface Props {
  name: keyof typeof ICONS | string;
  class?: string;
}
const { name, class: className = '' } = Astro.props;
const raw = ICONS[name];
if (!raw) throw new Error(`Unbekanntes Symbol: ${name}`);
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace(/class="[^"]*"/, `class="icon ${className}" aria-hidden="true" focusable="false"`)
  .replace(/\swidth="24"/, '')
  .replace(/\sheight="24"/, '');
---

<Fragment set:html={svg} />
