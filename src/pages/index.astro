---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { HILFE, THEMEN } from '../config';
import { url } from '../lib';

// Höchstens 6 Kacheln: die Themen. „Alle Anleitungen“ und „Wörter erklärt“ stehen als Knöpfe darunter.
const kacheln = THEMEN.filter((t) => t.kachel !== false).map((t) => ({
  titel: t.titel,
  text: t.kurz,
  icon: t.icon,
  href: url(`${t.id}/`),
}));

// Problemlöser: die häufigsten Probleme direkt auf der Startseite.
const probleme = (await getCollection('lektionen', (l) => l.data.thema === 'probleme')).sort(
  (a, b) => a.data.nummer - b.data.nummer,
);
if (kacheln.length > 6) throw new Error('Die Startseite darf höchstens 6 Kacheln haben.');
---

<Base titel="Startseite">
  <section class="begruessung" aria-labelledby="gruss">
    <h1 id="gruss" data-gruss>Willkommen beim Digital-Helfer</h1>
    <p data-datum>Hier finden Sie Anleitungen für Computer, Internet und KI.</p>
  </section>

  <form class="suchfeld" role="search" action={url('suche/')} method="get">
    <label for="suche-start">Was möchten Sie wissen?</label>
    <input id="suche-start" name="q" type="search" placeholder="z. B. Text kopieren" autocomplete="off" />
    <button class="knopf knopf--voll" type="submit">
      <Icon name="search" />
      Suchen
    </button>
  </form>

  <section class="problemloeser" aria-labelledby="probleme-titel">
    <h2 id="probleme-titel">
      <Icon name="wrench" />
      Hilfe, ich habe ein Problem
    </h2>
    <ul>
      {
        probleme.map((p) => (
          <li>
            <a href={url(`${p.id}/`)}>
              <span>{p.data.titel}</span>
              <Icon name="chevron-right" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <h2 class="nur-vorlesen">Themen</h2>
  <ul class="kacheln">
    {
      kacheln.map((k) => (
        <li>
          <a class="kachel" href={k.href}>
            <Icon name={k.icon} />
            <span class="kachel__titel">{k.titel}</span>
            <span class="kachel__text">{k.text}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="zusatz-link">
    <a class="knopf" href={url('alle/')}>
      <Icon name="list" />
      Alle Anleitungen auf einen Blick
    </a>
    <a class="knopf" href={url('glossar/')}>
      <Icon name="book-open" />
      Wörter erklärt: Fachwörter von A bis Z
    </a>
  </p>

  <aside class="hinweis-hilfe" aria-label="Hilfe">
    <p>Etwas klappt nicht? {HILFE.name} hilft Ihnen gern.</p>
    <a class="knopf knopf--hilfe" href={url('hilfe/')}>
      <Icon name="phone" />
      Hilfe holen
    </a>
  </aside>
</Base>

<script>
  // Begrüßung passend zur Tageszeit, dazu das heutige Datum.
  const jetzt = new Date();
  const h = jetzt.getHours();
  const gruss = h < 11 ? 'Guten Morgen' : h < 18 ? 'Guten Tag' : 'Guten Abend';
  const datum = jetzt.toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const el = document.querySelector('[data-gruss]');
  const d = document.querySelector('[data-datum]');
  if (el) el.textContent = `${gruss}!`;
  if (d) d.textContent = `Heute ist ${datum}.`;
</script>
