---
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { NICHT_INDEXIEREN } from '../config';
import { url } from '../lib';

interface Krume {
  titel: string;
  href?: string;
}
interface Props {
  titel: string;
  beschreibung?: string;
  /** Brotkrumen-Pfad ohne „Startseite“ (wird automatisch vorangestellt) */
  krumen?: Krume[];
  /** Ziel des Zurück-Knopfs. Fehlt er, ist dies die Startseite. */
  zurueck?: { href: string; titel: string };
}
const { titel, beschreibung = 'Digital-Helfer: Anleitungen für PC, Internet und KI in einfacher Sprache.', krumen, zurueck } = Astro.props;
const seitenTitel = krumen ? `${titel} | Digital-Helfer` : 'Digital-Helfer';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={beschreibung} />
    {NICHT_INDEXIEREN && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#174a7c" />
    <script is:inline>
      // Gewählte Schriftgröße sofort anwenden, damit nichts springt.
      try {
        var s = localStorage.getItem('dh-schrift');
        if (s === '2' || s === '3') document.documentElement.dataset.schrift = s;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="sprung-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf">
      <div class="seite kopf__innen">
        <a class="marke" href={url()}>
          <Icon name="house" />
          <span>Digital-Helfer<span class="nur-vorlesen">, zur Startseite</span></span>
        </a>
        <div class="kopf__werkzeuge">
          <div class="schrift" role="group" aria-labelledby="schrift-titel">
            <span class="schrift__titel" id="schrift-titel">Schrift:</span>
            <button type="button" class="knopf" data-schrift-aendern="-1" ><span aria-hidden="true">A&minus;</span> kleiner</button>
            <button type="button" class="knopf" data-schrift-aendern="1" ><span aria-hidden="true">A+</span> größer</button>
            <span class="nur-vorlesen" aria-live="polite" id="schrift-meldung"></span>
          </div>
          <a class="knopf knopf--hilfe" href={url('hilfe/')}>
            <Icon name="life-buoy" />
            Ich brauche Hilfe
          </a>
        </div>
      </div>
    </header>

    <div class="seite">
      {
        krumen && (
          <nav class="orientierung" aria-label="Wo bin ich?">
            <a class="knopf" href={zurueck?.href ?? url()}>
              <Icon name="arrow-left" />
              Zurück{zurueck ? ` zu ${zurueck.titel}` : ' zur Startseite'}
            </a>
            <div class="brotkrumen">
              <span class="nur-vorlesen">Sie sind hier:</span>
              <ol>
                <li>
                  <a href={url()}>Startseite</a>
                </li>
                {krumen.map((k) => (
                  <li>{k.href ? <a href={k.href}>{k.titel}</a> : <span aria-current="page">{k.titel}</span>}</li>
                ))}
              </ol>
            </div>
          </nav>
        )
      }
      <main id="inhalt" tabindex="-1">
        <slot />
      </main>
    </div>

    <footer class="fuss">
      <div class="seite">
        <p>Digital-Helfer: Anleitungen in einfacher Sprache. Sie können nichts kaputt machen. Probieren Sie es in Ruhe aus.</p>
      </div>
    </footer>

    <script>
      const STUFEN = ['1', '2', '3'];
      const NAMEN = ['normal', 'groß', 'sehr groß'];
      const html = document.documentElement;
      const meldung = document.getElementById('schrift-meldung');
      const knoepfe = document.querySelectorAll<HTMLButtonElement>('[data-schrift-aendern]');

      function aktuell(): number {
        return Math.max(0, STUFEN.indexOf(html.dataset.schrift ?? '1'));
      }
      function anzeigen() {
        const i = aktuell();
        knoepfe.forEach((k) => {
          const richtung = Number(k.dataset.schriftAendern);
          k.disabled = (richtung < 0 && i === 0) || (richtung > 0 && i === STUFEN.length - 1);
        });
      }
      knoepfe.forEach((k) =>
        k.addEventListener('click', () => {
          const i = Math.min(STUFEN.length - 1, Math.max(0, aktuell() + Number(k.dataset.schriftAendern)));
          if (i === 0) delete html.dataset.schrift;
          else html.dataset.schrift = STUFEN[i];
          try {
            localStorage.setItem('dh-schrift', STUFEN[i]);
          } catch {}
          if (meldung) meldung.textContent = `Schriftgröße: ${NAMEN[i]}`;
          anzeigen();
          // Fokus bleibt auf einem bedienbaren Knopf, auch wenn dieser gesperrt wurde.
          if (k.disabled) {
            const anderer = [...knoepfe].find((x) => !x.disabled);
            anderer?.focus();
          }
        }),
      );
      anzeigen();
    </script>
  </body>
</html>
